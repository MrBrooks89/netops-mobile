# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# test output
/coverage/

# generated native folders
/ios
/android

# gradle output inside local Expo modules (source only)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/ios/Pods/

# local dev toolchain (JDK, Android SDK, AVDs, caches) — reproducible via scripts/setup-env.sh
.tools/
.toolcache/

# agent/session scaffolding not part of the product
.claude/
.codegraph/
.omo/
